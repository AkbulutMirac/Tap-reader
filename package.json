{
  "name": "tap-reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-assets.mjs",
    "predev": "node scripts/copy-assets.mjs",
    "prebuild": "node scripts/copy-assets.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "node scripts/e2e.mjs && node scripts/e2e.mjs http://localhost:5173 . --mobile && node scripts/e2e-features.mjs",
    "test-files": "node scripts/make-test-files.mjs",
    "deploy": "npm run build && npx wrangler pages deploy",
    "sample": "node scripts/make-sample-pdf.mjs",
    "dict:data": "node scripts/fetch-dict-data.mjs",
    "dict": "node --experimental-strip-types --no-warnings scripts/build-dictionary.ts"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@mozilla/readability": "^0.6.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "dompurify": "^3.4.16",
    "foliate-js": "^1.0.1",
    "libarchive.js": "^2.0.2",
    "mammoth": "^1.13.0",
    "marked": "^18.0.14",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
